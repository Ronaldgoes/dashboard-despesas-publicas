# Necessárias somente no seu computador para publicar no Cloudflare R2.
CLOUDFLARE_ACCOUNT_ID=cole_o_account_id
R2_ACCESS_KEY_ID=cole_a_access_key
R2_SECRET_ACCESS_KEY=cole_a_secret_key
R2_BUCKET_NAME=notas-empenho

# URL pública do bucket, usada no navegador e no Vercel.
VITE_EMPENHOS_STORAGE_URL=https://COLE_A_URL_PUBLICA_DO_BUCKET
